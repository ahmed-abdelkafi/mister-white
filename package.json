{
  "name": "mister-white-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=@mister-white/web run dev",
    "dev:worker": "npm --workspace=@mister-white/worker run dev",
    "build": "npm --workspaces run build",
    "deploy:worker": "npm --workspace=@mister-white/worker run deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
